{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(cd:*)",
      "Bash(echo:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(test:*)",
      "Bash(sleep:*)",
      "Bash(true:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(bd:*)",
      "Bash(bun:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(curl:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(source:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(xargs:*)",
      "Bash(jq:*)",
      "Bash(timeout:*)",
      "Bash(tee:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(find:*)",
      "mcp__fetch__fetch",
      "mcp__github__*",
      "Bash(column *)",
      "Edit(.claude/state/**)",
      "Bash(date *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(uniq *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(bash *)",
      "Bash(test *)",
      "Bash(true)",
      "Bash(false)"
    ],
    "deny": [
      "Bash(cat .env:*)",
      "Bash(cat *credentials*:*)",
      "Bash(cat *secret*:*)",
      "Bash(cat *token*:*)",
      "Bash(sudo:*)",
      "Bash(chown:*)",
      "Bash(tmux:*)",
      "Bash(powershell:*)"
    ]
  }
}
